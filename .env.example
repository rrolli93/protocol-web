# Copy to .env.local. Never commit real values. Never use live Stripe keys.

# Supabase (Rafael provides these from the linked project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paid mode is off unless this is exactly "true". Real charges still require sk_test_.
DARE_PAID_MODE=false

# Fee model: percent (default, taken from the bounty) or surcharge (paid on top).
# DARE_FEE_MODEL=surcharge
# DARE_FEE_PERCENT_BPS=1000
# DARE_SURCHARGE_FIXED_CENTS=200
# DARE_SURCHARGE_BPS=500
# DARE_MIN_BOUNTY_CENTS=2000
# DARE_MAX_BOUNTY_CENTS=10000

# Optional Gemini free-tier proof check. Unset = mock, which queues for a person.
# DARE_AI_PROVIDER=gemini
# GEMINI_API_KEY=

# Optional USDC rail on Base Sepolia. Off unless exactly "true". Never Base mainnet.
# CRYPTO_RAIL_ENABLED=false
# DARE_ESCROW_ADDRESS=
# DARE_ORACLE=
# DARE_TREASURY=
# DARE_OWNER=
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional email. Unset = in-app notifications only.
# DARE_EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# DARE_EMAIL_FROM=

# Stripe TEST keys only. The server rejects sk_live_ and pk_live_.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Local click-through without Stripe keys. Leave empty outside your own machine.
# DARE_STRIPE_MOCK=true
# DARE_DEV_STORE=memory
DARE_STRIPE_MOCK=false
DARE_DEV_STORE=

# Optional. When true, a proof upload can pass fixture=pass|fail|unsure|injection.
DARE_AI_ALLOW_FIXTURES=false
# Leave unset to use the mock checker, which queues proofs for a person.
# DARE_AI_PROVIDER=http
# DARE_AI_API_URL=
# DARE_AI_API_KEY=

# Required for settlement jobs. There is no default.
CRON_SECRET=

# Comma-separated emails treated as reviewers, in addition to users.is_admin.
DARE_ADMIN_EMAILS=

NEXT_PUBLIC_APP_URL=http://localhost:3000
